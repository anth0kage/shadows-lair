#!/usr/bin/env bash
# Usage : echo "<mot de passe>" | lair-vault-ajout "<nom>" "<identifiant>"
set -euo pipefail
source ~/.hermes/lair-vault.env
export BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD
if bw status | grep -q '"status":"unauthenticated"'; then bw login --apikey >/dev/null; fi
S=$(bw unlock --passwordenv BW_PASSWORD --raw)
PW=$(cat)
bw get template item --session "$S" \
  | jq --arg n "$1" --arg u "$2" --arg p "$PW" '.type=1 | .name=$n | .notes=null | .login={username:$u,password:$p,totp:null}' \
  | bw encode | bw create item --session "$S" >/dev/null
bw sync --session "$S" >/dev/null
echo "Enregistré dans le coffre : $1"
